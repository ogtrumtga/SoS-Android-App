<?xml version="1.0" encoding="utf-8"?>
<!-- 4. Tạo yêu cầu cứu hộ SOS (Chuẩn API POST /api/sos) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar.Minimal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="Chia sẻ vị trí và tình trạng hiện tại"
        app:title="Gửi tín hiệu SOS" />

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. Tọa độ khởi tạo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. VỊ TRÍ HIỆN TẠI" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshGps"
                    style="@style/Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:text="Lấy lại GPS" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <org.maplibre.android.maps.MapView
                        android:id="@+id/mapPreview"
                        android:layout_width="match_parent"
                        android:layout_height="168dp" />

                    <View style="@style/Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCoordinates"
                                style="@style/Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10.776889, 106.700806"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Chạm lên bản đồ để điều chỉnh điểm ghim" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAccuracy"
                            style="@style/Text.Tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/green_soft"
                            android:text="±4.5m"
                            android:textColor="@color/green" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Chọn loại sự cố khẩn cấp -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="2. LOẠI SỰ CỐ KHẨN CẤP" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="2dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFlood"
                    style="@style/Chip.Minimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Ngập lụt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedical"
                    style="@style/Chip.Minimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cấp cứu y tế" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCollapse"
                    style="@style/Chip.Minimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mắc kẹt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFood"
                    style="@style/Chip.Minimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhu yếu phẩm" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFire"
                    style="@style/Chip.Minimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hỏa hoạn" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 3. Mô tả tình trạng thực tế -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="3. MÔ TẢ TÌNH TRẠNG" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Số người cần hỗ trợ, mức ngập, điểm nhận diện..."
                app:counterEnabled="true"
                app:counterMaxLength="300">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:text="Nước ngập tầng 1, cần xuồng đưa 2 người già di chuyển" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupQuickTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="2dp">

                <com.google.android.material.chip.Chip
                    style="@style/Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Nước ngập tầng 1" />

                <com.google.android.material.chip.Chip
                    style="@style/Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Cần xuồng sơ tán" />

                <com.google.android.material.chip.Chip
                    style="@style/Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Có người già &amp; trẻ nhỏ" />

                <com.google.android.material.chip.Chip
                    style="@style/Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Mất điện, sắp hết pin" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 4. Chế độ hiển thị -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="4. QUYỀN RIÊNG TƯ" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioGroup
                    android:id="@+id/rgPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@id/rbPublic"
                    android:padding="12dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbPublic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:text="Công khai – Hiển thị vùng cảnh báo (~1km) trên bản đồ cộng đồng"
                        android:textColor="@color/ink"
                        android:textSize="13.5sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbPrivate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingVertical="4dp"
                        android:text="Riêng tư – Ẩn khỏi bản đồ cộng đồng, chỉ đội cứu hộ tiếp nhận mới thấy"
                        android:textColor="@color/ink"
                        android:textSize="13.5sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Đường dây nóng dự phòng khi mất mạng -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GỌI KHẨN CẤP KHI MẤT KẾT NỐI MẠNG" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall112"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="42dp"
                    android:text="112" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall114"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="42dp"
                    android:text="114" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall115"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="42dp"
                    android:text="115" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall113"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minHeight="42dp"
                    android:text="113" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View style="@style/Divider" />

    <!-- Nút gửi cố định dưới cùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSos"
            style="@style/Button.Sos"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Phát tín hiệu cứu hộ SOS"
            app:icon="@drawable/ic_campaign"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
