<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar.Minimal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Thông báo" />

    <View style="@style/Divider" />

    <!-- Thanh lọc thông báo dạng Chip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Chip.Minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnread"
                style="@style/Chip.Minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa đọc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSos"
                style="@style/Chip.Minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cứu hộ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAlert"
                style="@style/Chip.Minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khẩn cấp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSystem"
                style="@style/Chip.Minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hệ thống" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View style="@style/Divider" />

    <!-- Danh sách thông báo & Trạng thái trống -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_notification" />

        <!-- Giao diện khi không có thông báo -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Không có thông báo"
                android:src="@drawable/ic_notifications"
                app:tint="@color/ink_disabled" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Không có thông báo nào"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Các cập nhật về cứu hộ và thông báo hệ thống sẽ được liệt kê tại đây." />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
