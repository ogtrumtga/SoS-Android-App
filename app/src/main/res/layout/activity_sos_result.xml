<?xml version="1.0" encoding="utf-8"?>
<!-- 6. Kết quả đóng phiên SOS (Chuẩn API POST /complete, POST /cancel, GET /api/sos/{id}/logs & RB09) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar.Minimal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_close"
        app:subtitle="Phiên cứu hộ đã kết thúc"
        app:title="Kết quả phiên cứu hộ" />

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Biểu tượng trạng thái đóng phiên -->
            <ImageView
                android:id="@+id/imgResult"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/green_soft"
                android:contentDescription="Trạng thái đóng phiên"
                android:padding="16dp"
                android:src="@drawable/ic_check"
                app:tint="@color/green" />

            <TextView
                android:id="@+id/tvStatusBadge"
                style="@style/Text.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/green_soft"
                android:text="ĐÃ HOÀN THÀNH"
                android:textColor="@color/green" />

            <TextView
                android:id="@+id/tvResultTitle"
                style="@style/Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Phiên cứu hộ đã hoàn thành" />

            <TextView
                android:id="@+id/tvResultSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Đội cứu hộ đã xác nhận hoàn tất hỗ trợ và đưa bạn đến nơi an toàn." />

            <!-- Thông tin bản ghi sos_requests -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÃ YÊU CẦU" />

                            <TextView
                                android:id="@+id/tvSosCode"
                                style="@style/Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="#2CC295A6" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyCode"
                            style="@style/Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sao chép"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THỜI GIAN GỬI" />

                            <TextView
                                android:id="@+id/tvClosedAt"
                                style="@style/Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="09:21:34 • Hôm nay"
                                android:textSize="13.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TRẠNG THÁI ĐÓNG" />

                            <TextView
                                android:id="@+id/tvDuration"
                                style="@style/Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Đội cứu hộ hoàn tất"
                                android:textSize="13.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        style="@style/Divider"
                        android:layout_marginVertical="14dp" />

                    <TextView
                        android:id="@+id/tvRescueTeam"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đội cứu hộ: Đội Cứu Hộ Phản Ứng Nhanh Quận 1"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvEvacuated"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Loại sự cố: Ngập lụt" />

                    <TextView
                        android:id="@+id/tvShelter"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mô tả: Nước ngập tầng 1, cần xuồng đưa 2 người già di chuyển" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thông báo bảo mật quyền riêng tư -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_box"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="Hệ thống đã tự động ngắt chia sẻ vị trí trực tiếp để bảo vệ quyền riêng tư của bạn."
                android:textColor="@color/ink_secondary" />

            <!-- Nhật ký hoạt động -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NHẬT KÝ HOẠT ĐỘNG" />

                    <TextView
                        android:id="@+id/tvAuditLogs"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• 09:21 • Đã phát tín hiệu cứu hộ"
                        android:textColor="@color/ink_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút hành động -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToMap"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quay về Bản đồ Cộng đồng" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifyFamily"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chia sẻ thông báo an toàn" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
